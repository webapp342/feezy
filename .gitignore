# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.*
!.env.example

# vercel / local tooling
.vercel
.cursor/
agent-transcripts/

# typescript
*.tsbuildinfo
next-env.d.ts

# temp previews
public/brand/kit/_*.png

# ── Brand: social pack (X/TG — local only, not served by site) ──
public/brand/social/masters/
public/brand/social/*.png

# ── Brand: heavy source art (site uses opt/*.webp + kit gifs/stickers) ──
public/brand/feezy-bg-hero.png
public/brand/feezy-hero.png
public/brand/feezy-logo.png
public/brand/feezy-bounce.gif
public/brand/feezy-fee-drop.gif

# Kit PNG masters — runtime stickers kept via ! rules below
public/brand/kit/*.png
!public/brand/kit/feezy-sticker-shush.png
!public/brand/kit/feezy-sticker-timer.png
!public/brand/kit/feezy-sticker-xp.png

# Cursor / local AI exports (regenerate with scripts when needed)
assets/
